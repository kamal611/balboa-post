# Copy this file to .env and fill in your own values.

# Get a key at https://console.anthropic.com/ (Settings -> API Keys)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# The RSS or Atom feed the bot pulls source items from.
# Must be a feed you have the rights to republish/rewrite content from
# (your own feed, a partner feed, or one whose license explicitly allows it).
#
# Default below is the County of San Diego News Center feed: public-domain
# government press releases (health, housing, transportation, services),
# safe to rewrite freely. Swap it out once you have a licensed news feed.
FEED_URL=https://www.countynewscenter.com/news/rss

# How the bot should attribute/link back to the original source in each
# published article. Off by default since the county feed is public domain
# and doesn't require it. IMPORTANT: switch this back to "true" if you ever
# add a licensed feed (e.g. Voice of San Diego, Times of San Diego, a paid
# wire service) -- those require attribution as a condition of use.
INCLUDE_SOURCE_LINK=false

# Claude model used for rewriting.
CLAUDE_MODEL=claude-sonnet-4-5

# How different the rewritten article must be from the source, measured as
# the max allowed overlap of 8-word phrases (0.15 = at most ~15% of the
# rewritten article's phrasing may match the source). The bot automatically
# retries with a stronger rewrite instruction (up to 3 tries) if it comes
# back above this, and skips publishing that item entirely if it still
# can't get below the limit. Lower = more different from the source, but
# more retries (and API cost) on stubborn source text.
MAX_SOURCE_OVERLAP=0.15

# The site's name, shown in the masthead, page titles, and footer.
SITE_NAME=Balboa Post

# Port for the website.
PORT=3000
