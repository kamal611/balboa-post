<!doctype html>
<html lang="en">
<head>
  <title><%= article.title %> | <%= siteName %></title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/masthead') %>

  <main class="page page-article">
    <a class="back-link" href="/">&larr; Front Page</a>

    <article class="full-article">
      <a class="eyebrow eyebrow-<%= article.category.toLowerCase().replace(/\s+/g, '-') %>" href="/section/<%= article.category.toLowerCase().replace(/\s+/g, '-') %>"><%= article.category %></a>
      <h1><%= article.title %></h1>
      <% if (article.dek) { %><p class="dek"><%= article.dek %></p><% } %>
      <p class="byline">
        By Mark Glen &middot;
        <%= new Date(article.created_at + 'Z').toLocaleString('en-US', { month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %>
      </p>
      <div class="article-body">
        <%- article.body_html %>
      </div>
    </article>
  </main>

  <%- include('partials/footer') %>
</body>
</html>