<!doctype html>
<html lang="en">
<head>
  <title><%= siteName %> - <%= siteTagline %></title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/masthead') %>

  <main class="page">
    <% if (!lead) { %>
      <p class="empty">
        No articles yet. Set <code>FEED_URL</code> in <code>.env</code> and run the bot to publish the first one.
      </p>
    <% } %>

    <% if (lead) { %>
      <article class="lead-story">
        <a class="eyebrow eyebrow-<%= lead.category.toLowerCase().replace(/\s+/g, '-') %>" href="/section/<%= lead.category.toLowerCase().replace(/\s+/g, '-') %>"><%= lead.category %></a>
        <h1><a href="/article/<%= lead.slug %>"><%= lead.title %></a></h1>
        <% if (lead.dek) { %><p class="dek"><%= lead.dek %></p><% } %>
        <p class="byline">By Mark Glen &middot; <%= new Date(lead.created_at + 'Z').toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/Los_Angeles' }) %></p>
      </article>
    <% } %>

    <% sections.forEach(section => { %>
      <section class="front-section">
        <div class="front-section-heading">
          <h2><%= section.category %></h2>
          <a class="see-all" href="/section/<%= section.category.toLowerCase().replace(/\s+/g, '-') %>">More in <%= section.category %> &rarr;</a>
        </div>
        <div class="story-grid">
          <% section.articles.forEach(a => { %>
            <article class="story-card">
              <h3><a href="/article/<%= a.slug %>"><%= a.title %></a></h3>
              <% if (a.dek) { %><p class="dek"><%= a.dek %></p><% } %>
              <p class="meta"><%= new Date(a.created_at + 'Z').toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/Los_Angeles' }) %></p>
            </article>
          <% }) %>
        </div>
      </section>
    <% }) %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>