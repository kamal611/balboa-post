<footer class="sitefooter">
  <div class="sitefooter-inner">
    <img class="sitefooter-logo" src="/images/logo-wordmark.png" alt="<%= siteName %>" />
    <p class="sitefooter-sections">
      <% categories.forEach((cat, i) => { %><a href="/section/<%= cat.toLowerCase().replace(/\s+/g, '-') %>"><%= cat %></a> · <% }) %><a href="/about">About</a>
    </p>
    <p class="sitefooter-disclosure">
      &copy; <%= new Date().getFullYear() %> <%= siteName %>.
    </p>
  </div>
</footer>